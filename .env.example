# Copy to .env — or just run the bot once and it will ask for these and create .env itself.
# این فایل را به .env کپی کنید — یا فقط یک بار برنامه را اجرا کنید تا خودش بپرسد و .env را بسازد.

# ── Required | لازم ──────────────────────────────────────────────
# From https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# From @BotFather → /newbot  (a separate bot, used only as your admin panel)
PANEL_BOT_TOKEN=

# ── Optional | اختیاری ───────────────────────────────────────────
# Extra panel admins (numeric Telegram IDs, comma-separated). The account owner is always an admin.
# EXTRA_ADMIN_IDS=
# Session / database / log file names (relative to the bot folder)
# TG_SESSION=assistant_session
# DB_PATH=assistant.db
# LOG_PATH=assistant.log
# API keys can also be given here instead of the panel (the panel value wins)
# GAPGPT_KEY=
# OPENROUTER_KEY=
